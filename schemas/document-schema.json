{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/schemas/document/v1",
  "type": "object",
  "required": [
    "format",
    "formatVersion",
    "id",
    "title",
    "profile",
    "state",
    "model",
    "revision",
    "evidence",
    "views",
    "snippets",
    "context",
    "snapshots",
    "baselineId"
  ],
  "properties": {
    "format": {
      "const": "atlas/document"
    },
    "formatVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "type": "string"
    },
    "profile": {
      "enum": [
        "ontouml",
        "database",
        "code"
      ]
    },
    "state": {
      "enum": [
        "authored",
        "snapshot",
        "proposal"
      ]
    },
    "model": {
      "type": "object"
    },
    "evidence": {
      "type": "object"
    },
    "views": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/view"
      }
    },
    "snippets": {
      "type": "object"
    },
    "baselineId": {
      "type": [
        "string",
        "null"
      ]
    },
    "imported": {
      "type": "boolean"
    },
    "workId": { "type": "string", "minLength": 1 },
    "revision": {
      "type": "object",
      "required": [
        "id",
        "parentId",
        "createdAt",
        "reason"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "parentId": {
          "type": [
            "string",
            "null"
          ]
        },
        "createdAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "context": {
      "type": "object",
      "required": [
        "records",
        "links"
      ],
      "properties": {
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind",
              "text"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "kind": {
                "enum": [
                  "plan",
                  "glossary",
                  "decision",
                  "scenario"
                ]
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "elementId",
              "recordId"
            ],
            "properties": {
              "elementId": {
                "$ref": "#/$defs/id"
              },
              "recordId": {
                "$ref": "#/$defs/id"
              }
            }
          }
        }
      }
    },
    "snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "profile",
          "model",
          "capture",
          "integrity"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "profile": {
            "enum": [
              "ontouml",
              "database",
              "code"
            ]
          },
          "model": {
            "type": "object"
          },
          "integrity": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "capture": {
            "type": "object",
            "required": [
              "capturedAt",
              "adapter",
              "source",
              "coverage"
            ],
            "properties": {
              "capturedAt": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
              },
              "adapter": {
                "type": "object",
                "required": [
                  "id",
                  "version"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "version": {
                    "type": "string"
                  }
                }
              },
              "source": {
                "type": "object",
                "required": [
                  "kind",
                  "identity",
                  "scope"
                ],
                "properties": {
                  "kind": {
                    "type": "string"
                  },
                  "identity": {
                    "type": "string"
                  },
                  "scope": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "coverage": {
                "type": "object",
                "required": [
                  "status",
                  "diagnostics"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "complete",
                      "partial"
                    ]
                  },
                  "diagnostics": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "profile": {
            "enum": [
              "database",
              "code"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "model": {
            "$ref": "#/$defs/graph"
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "graph": {
      "type": "object",
      "required": [
        "type",
        "nodes",
        "relations",
        "generalizations",
        "generalizationSets"
      ],
      "properties": {
        "type": {
          "const": "StructuralModel"
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "attributes"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "name": {
                "type": "string"
              },
              "attributes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "type"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string"
                    },
                    "id": {
                      "$ref": "#/$defs/id"
                    },
                    "multiplicity": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              },
              "kind": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "isAbstract": {
                "type": "boolean"
              }
            }
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "sourceId",
              "targetId",
              "sourceMultiplicity",
              "targetMultiplicity"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "name": {
                "type": "string"
              },
              "sourceId": {
                "$ref": "#/$defs/id"
              },
              "targetId": {
                "$ref": "#/$defs/id"
              },
              "sourceMultiplicity": {
                "type": "string"
              },
              "targetMultiplicity": {
                "type": "string"
              }
            }
          }
        },
        "generalizations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "specificId",
              "generalId"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "specificId": {
                "$ref": "#/$defs/id"
              },
              "generalId": {
                "$ref": "#/$defs/id"
              }
            }
          }
        },
        "generalizationSets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "generalizations",
              "complete",
              "disjoint"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "name": {
                "type": "string"
              },
              "generalizations": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "complete": {
                "type": "boolean"
              },
              "disjoint": {
                "type": "boolean"
              }
            }
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "view": {
      "type": "object",
      "required": [
        "key",
        "nodeIds"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "nodeIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "edgeIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "focusIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            },
            "uniqueItems": true
          }
        },
        "mergeGeneralizations": {
          "type": "boolean"
        },
        "direction": {
          "enum": [
            "RIGHT",
            "DOWN"
          ]
        },
        "label": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      }
    }
  }
}
