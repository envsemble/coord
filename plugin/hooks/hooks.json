{
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "atlas hook SessionStart", "timeout": 30 }] }],
    "PostToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|apply_patch|mcp__.*atlas.*",
        "hooks": [{ "type": "command", "command": "atlas hook PostToolUse", "timeout": 30 }]
      }
    ],
    "Stop": [{ "hooks": [{ "type": "command", "command": "atlas hook Stop", "timeout": 60 }] }],
    "SubagentStop": [{ "hooks": [{ "type": "command", "command": "atlas hook SubagentStop", "timeout": 60 }] }]
  }
}
