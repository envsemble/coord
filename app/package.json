  },
  "dependencies": {
    "ontouml-atlas": "file:vendor/ontouml-atlas-159cd8879976.tgz",
    "@primer/primitives": "^11.10.0",
    "express": "^5.2.1",
    "github-slugger": "2.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "latest",
    "remark-gfm": "latest",
    "tsx": "latest",
    "yaml": "latest"
  },
  "devDependencies": {
    "@types/express": "^5",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "latest",
    "vite": "^8.3.3"
