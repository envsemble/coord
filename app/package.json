{
  "name": "@envsemble/atlas-app",
  "productName": "Atlas",
  "version": "0.8.0",
  "private": true,
  "description": "Atlas desktop app: plans, models and shared understanding for agents and the people they work with",
  "author": "envsemble",
  "license": "UNLICENSED",
  "homepage": "https://github.com/envsemble/atlas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/envsemble/atlas.git",
    "directory": "app"
  },
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/electron.mjs electron-vite dev --watch --",
    "build": "npm run check:types && electron-vite build",
    "package": "npm run build && electron-builder --config electron-builder.yml --publish never --dir -c.directories.output=release/e2e -c.electronFuses.enableNodeCliInspectArguments=true -c.extraMetadata.atlasEndToEndBuild=true && electron-builder --config electron-builder.yml --publish never",
    "test": "tsx --import ../scripts/test-home.mjs --test \"src/*.test.ts\" && node --import ../scripts/test-home.mjs --test \"main/*.test.ts\" \"shared/*.test.ts\"",
    "test:e2e": "node scripts/electron.mjs playwright test",
    "check:types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@envsemble/atlas-diagrams": "*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@electron/fuses": "1.8.0",
    "@envsemble/atlas-host": "*",
    "@envsemble/atlas-planning": "*",
    "@envsemble/envui": "0.7.0",
    "@playwright/test": "1.64.0",
    "@shikijs/langs": "4.5.0",
    "@pierre/theme": "2.0.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0-beta.7",
    "github-slugger": "2.0.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "shiki": "4.5.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "^8.3.3"
  }
}
