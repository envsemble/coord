{
  "name": "@envsemble/worktrail-dashboard",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/envsemble/worktrail.git",
    "directory": "dashboard"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx server/index.ts --dev",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "node scripts/check-atlas.mjs && node --test scripts/package-atlas.test.mjs && tsx --test src/visiblePoll.test.ts src/modelSelection.test.ts src/status.test.ts server/planning.test.ts server/telemetry.test.ts server/links.test.ts server/headings.test.ts server/http.test.ts server/atlas.test.ts server/planningRoots.test.ts",
    "atlas:package": "node scripts/package-atlas.mjs",
    "release:assemble": "node scripts/assemble-worktrail.mjs",
    "check:release": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "@primer/octicons-react": "19.40.0",
    "@primer/primitives": "^11.10.0",
    "express": "^5.2.1",
    "fflate": "0.8.3",
    "github-slugger": "2.0.0",
    "ontouml-atlas": "file:vendor/ontouml-atlas-fdb485dcd4ec.tgz",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "latest",
    "remark-gfm": "latest",
    "tsx": "latest",
    "yaml": "latest"
  },
  "devDependencies": {
    "@types/express": "^5",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "latest",
    "vite": "^8.3.3"
  }
}
