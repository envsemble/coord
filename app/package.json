{
  "name": "planning-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx server/index.ts --dev",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "node scripts/check-atlas.mjs && tsx --test server/planning.test.ts server/telemetry.test.ts server/links.test.ts server/headings.test.ts server/http.test.ts server/atlas.test.ts",
