{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "electron-vite/node"]
  },
  "include": ["main", "preload", "shared", "e2e", "electron.vite.config.ts", "playwright.config.ts"]
}
