{
  "name": "atlas",
  "version": "0.5.0",
  "private": true,
  "description": "Plans, models and shared understanding for agents and the people they work with",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/envsemble/atlas.git"
  },
  "homepage": "https://github.com/envsemble/atlas",
  "bugs": {
    "url": "https://github.com/envsemble/atlas/issues"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "app"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @atlas/diagrams",
    "dev:app": "npm run dev --workspace @atlas/app",
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "test:skills": "node --test \"skills/tests/*.test.mjs\"",
    "format": "npm run format --workspace @atlas/diagrams && prettier --write \"docs/*.md\" scripts README.md CONTEXT.md CONTRIBUTING.md CHANGELOG.md THIRD_PARTY_NOTICES.md package.json",
    "format:check": "npm run format:check --workspace @atlas/diagrams && prettier --check \"docs/*.md\" scripts README.md CONTEXT.md CONTRIBUTING.md CHANGELOG.md THIRD_PARTY_NOTICES.md package.json",
    "check:types": "npm run check:types --workspaces --if-present",
    "check": "npm run check --workspace @atlas/diagrams",
    "check:package": "npm run check:package --workspace @atlas/diagrams",
    "check:performance": "npm run check:performance --workspace @atlas/diagrams",
    "check:review": "npm run check:review --workspace @atlas/app",
    "review:example": "node packages/diagrams/scripts/review-example.cjs",
    "release:assemble": "node scripts/release.cjs",
    "check:release": "node scripts/check-release.cjs"
  },
  "devDependencies": {
    "fflate": "0.8.3",
    "prettier": "3.8.0"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
