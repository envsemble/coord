{
  "name": "ontouml-atlas",
  "version": "0.4.0",
  "private": true,
  "description": "Agent-ready OntoUML validation, offline visualization and learning",
  "scripts": {
    "build": "node scripts/build.cjs",
    "check": "node scripts/check.cjs",
    "test": "node scripts/test.cjs",
    "format": "prettier --write src lib bin scripts tests examples schemas/*.json agents README.md CONTEXT.md THIRD_PARTY_NOTICES.md package.json",
    "format:check": "prettier --check src lib bin scripts tests examples agents README.md CONTEXT.md THIRD_PARTY_NOTICES.md package.json",
    "check:types": "tsc --noEmit -p tsconfig.contracts.json",
    "build:library": "node scripts/build-library.cjs",
    "prepack": "node scripts/build-library.cjs",
    "check:package": "node scripts/check-package.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "prettier": "3.8.0",
    "typescript": "7.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "elkjs": "0.12.0",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "ontouml-js": "1.0.0",
    "shiki": "4.5.0"
  },
  "license": "UNLICENSED",
  "main": "./lib/index.cjs",
  "types": "./lib/index.d.ts",
  "bin": {
    "ontouml-atlas": "./bin/ontouml.cjs"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.cjs",
      "default": "./lib/index.cjs"
    },
    "./react": {
      "types": "./src/index.d.ts",
      "default": "./dist/react.mjs"
    },
    "./viewer.css": "./src/ui/styles.css",
    "./diagram.css": "./src/visualization/styles.css",
    "./schema": "./schemas/ontouml-schema.json",
    "./evidence-schema": "./schemas/evidence-schema.json"
  },
  "files": [
    "lib/",
    "bin/",
    "src/",
    "schemas/",
    "licenses/",
    "agents/",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "dist/"
  ],
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
