{
  "name": "atlas",
  "version": "0.6.0",
  "private": true,
  "description": "Plans, models and shared understanding for agents and the people they work with",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/envsemble/atlas.git"
  },
  "homepage": "https://github.com/envsemble/atlas",
  "bugs": {
    "url": "https://github.com/envsemble/atlas/issues"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "app"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @envsemble/atlas-app",
    "dev:diagrams": "npm run dev --workspace @envsemble/atlas-diagrams",
    "dev:envui": "node scripts/dev-envui.mjs",
    "envui:unlink": "node scripts/dev-envui.mjs --unlink",
    "preview": "npm run preview --workspace @envsemble/atlas-diagrams",
    "build": "npm run build --workspaces --if-present",
    "package": "npm run package --workspace @envsemble/atlas-app",
    "test": "npm test --workspaces --if-present",
    "test:skills": "node --test \"skills/tests/*.test.mjs\"",
    "test:e2e": "npm run test:e2e --workspace @envsemble/atlas-app",
    "format": "npm run format --workspace @envsemble/atlas-diagrams && prettier --write \"docs/*.md\" scripts README.md CONTEXT.md CONTRIBUTING.md CHANGELOG.md THIRD_PARTY_NOTICES.md package.json",
    "format:check": "npm run format:check --workspace @envsemble/atlas-diagrams && prettier --check \"docs/*.md\" scripts README.md CONTEXT.md CONTRIBUTING.md CHANGELOG.md THIRD_PARTY_NOTICES.md package.json",
    "check:types": "npm run check:types --workspaces --if-present",
    "check": "npm run check --workspace @envsemble/atlas-diagrams",
    "check:package": "npm run check:package --workspace @envsemble/atlas-diagrams",
    "check:performance": "npm run check:performance --workspace @envsemble/atlas-diagrams",
    "release:assemble": "node scripts/release.cjs",
    "check:release": "node scripts/check-release.cjs"
  },
  "devDependencies": {
    "fflate": "0.8.3",
    "prettier": "3.8.0"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
