{
  "name": "@envsemble/coord",
  "version": "0.9.0",
  "private": true,
  "description": "The coord command, the Coord host and the planning-folder reader they share with the app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/envsemble/coord.git",
    "directory": "packages/coord"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "coord": "./bin/coord.js"
  },
  "exports": {
    "./agents": "./src/agents/agents.ts",
    "./agents/activity": "./src/agents/activity.ts",
    "./agents/trust": "./src/agents/trust.ts",
    "./planning": "./src/planning/index.ts",
    "./planning/headings": "./src/planning/reading/headings.ts",
    "./planning/ledger": "./src/planning/work/ledger.ts",
    "./planning/provenance": "./src/planning/reading/provenance.ts",
    "./planning/types": "./src/planning/types.ts",
    "./platform/paths": "./src/platform/paths.ts",
    "./platform/run": "./src/platform/run.ts",
    "./host": "./src/host/index.ts",
    "./host/contract": "./src/host/contract.ts",
    "./host/validate": "./src/host/validate.ts"
  },
  "scripts": {
    "test": "node ../../scripts/test-tier.mjs full --import ../../scripts/test-home.mjs src",
    "test:quick": "node ../../scripts/test-tier.mjs quick --import ../../scripts/test-home.mjs src",
    "check:types": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@envsemble/coord-diagrams": "*",
    "@hono/node-server": "2.1.8",
    "@modelcontextprotocol/sdk": "1.32.1",
    "github-slugger": "2.0.0",
    "hono": "4.13.18",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "qrcode": "1.5.4",
    "ws": "8.22.0",
    "yaml": "^2.9.1",
    "esbuild": "0.28.2"
  },
  "devDependencies": {
    "@types/mdast": "4.0.4",
    "@types/node": "^24",
    "@types/qrcode": "1.5.6",
    "@types/ws": "8.18.2",
    "typescript": "7.0.2"
  }
}
