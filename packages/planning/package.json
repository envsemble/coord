{
  "name": "@envsemble/atlas-planning",
  "version": "0.7.1",
  "private": true,
  "description": "Internal Atlas planning-folder reader shared by the atlas command and the app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/envsemble/atlas.git",
    "directory": "packages/planning"
  },
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./src/index.ts",
    "./diagrams": "./src/diagrams.ts",
    "./headings": "./src/headings.ts",
    "./ledger": "./src/ledger.ts",
    "./session": "./src/session.ts",
    "./paths": "./src/paths.ts",
    "./provenance": "./src/provenance.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "build": "node scripts/build-viewer.mjs",
    "test": "node --import ../../scripts/test-home.mjs --test \"src/*.test.ts\"",
    "check:types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p viewer/tsconfig.json"
  },
  "dependencies": {
    "@envsemble/atlas-diagrams": "*",
    "github-slugger": "2.0.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "parse5": "8.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@envsemble/envui": "0.6.0",
    "@shikijs/langs": "4.5.0",
    "@shikijs/themes": "4.5.0",
    "@types/mdast": "4.0.4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "4.5.0",
    "typescript": "7.0.2"
  }
}
