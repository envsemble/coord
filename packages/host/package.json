{
  "name": "@envsemble/atlas-host",
  "version": "0.6.0",
  "private": true,
  "description": "The Atlas host: serves planning folders to the desktop app and to paired devices over an authenticated connection",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/envsemble/atlas.git",
    "directory": "packages/host"
  },
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/contract.ts",
    "./client": "./src/client.ts",
    "./validate": "./src/validate.ts",
    "./serve": "./src/serve.ts",
    "./plan-worker": "./src/planWorker.ts"
  },
  "scripts": {
    "test": "node --test \"src/*.test.ts\"",
    "check:types": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@envsemble/atlas-planning": "*",
    "@hono/node-server": "2.1.4",
    "hono": "4.13.13",
    "qrcode": "1.5.4",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/qrcode": "1.5.6",
    "@types/ws": "8.18.2",
    "typescript": "7.0.2"
  }
}
