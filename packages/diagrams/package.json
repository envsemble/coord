{
  "name": "@envsemble/coord-diagrams",
  "version": "0.10.0",
  "private": true,
  "description": "Internal Coord diagram package: Coord's PlantUML subset, captures from code and databases, layout, the React viewer and offline export",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/envsemble/coord.git",
    "directory": "packages/diagrams"
  },
  "homepage": "https://github.com/envsemble/coord",
  "bugs": {
    "url": "https://github.com/envsemble/coord/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.cjs",
    "preview": "node scripts/preview.cjs",
    "check": "node scripts/check.cjs",
    "test": "node scripts/test.cjs",
    "test:quick": "node scripts/test.cjs --quick",
    "format": "prettier --write development vite.config.mjs src \"lib/**/*.{cjs,ts}\" scripts tests examples schemas/*.json package.json && prettier --plugin=prettier-plugin-java --write lib/capture/java/*.java",
    "format:check": "prettier --check development vite.config.mjs src \"lib/**/*.{cjs,ts}\" scripts tests examples package.json && prettier --plugin=prettier-plugin-java --check lib/capture/java/*.java",
    "check:types": "tsc --noEmit -p tsconfig.contracts.json",
    "build:library": "node scripts/build-library.cjs",
    "prepack": "node scripts/build-library.cjs",
    "check:package": "node scripts/check-package.cjs",
    "check:performance": "node scripts/check-performance.cjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@envsemble/envui": "3.0.0",
    "@types/react": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "peggy": "5.1.0",
    "postcss": "8.5.29",
    "postcss-selector-parser": "7.1.6",
    "prettier": "3.8.0",
    "prettier-plugin-java": "2.11.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "wrangler": "4.148.0"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "elkjs": "0.12.0",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "pg": "8.23.1",
    "typescript-compiler": "npm:typescript@6.0.3"
  },
  "license": "MIT",
  "main": "./lib/index.cjs",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.cjs",
      "default": "./lib/index.cjs"
    },
    "./react": {
      "types": "./src/index.d.ts",
      "default": "./dist/react.mjs"
    },
    "./mark": {
      "types": "./src/ui/CoordMark.d.ts",
      "default": "./dist/mark.mjs"
    },
    "./viewer.css": "./src/viewer/viewer.css",
    "./diagram.css": "./src/canvas/canvas.css",
    "./embedded.css": "./dist/embedded.css",
    "./database-source-schema": "./schemas/database-source-schema.json",
    "./code-source-schema": "./schemas/code-source-schema.json"
  },
  "files": [
    "lib/",
    "src/",
    "schemas/",
    "licenses/",
    "assets/",
    "dist/"
  ],
  "peerDependencies": {
    "@envsemble/envui": "*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
