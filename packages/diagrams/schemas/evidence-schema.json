{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/schemas/evidence/v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string" }, "version": { "type": "string" }, "status": { "type": "string" },
    "repositories": { "type": "array", "items": { "type": "object", "required": ["repo", "commit"], "additionalProperties": false, "properties": { "repo": { "type": "string" }, "commit": { "type": "string" } } } },
    "sources": { "type": "array", "items": { "type": "object", "required": ["id", "file", "title", "claim"], "additionalProperties": false, "properties": { "id": { "type": "string", "minLength": 1 }, "repo": { "type": "string" }, "commit": { "type": "string" }, "file": { "type": "string" }, "anchor": { "type": "string" }, "line": { "type": "integer", "minimum": 1 }, "url": { "type": "string", "format": "uri", "pattern": "^https?://" }, "title": { "type": "string" }, "claim": { "type": "string" } } } },
    "elements": { "type": "object", "additionalProperties": { "type": "object", "additionalProperties": false, "properties": { "evidence": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }, "primarySource": { "type": "string" }, "rationale": { "type": "string" }, "status": { "enum": ["observed", "inferred", "unresolved"] }, "questions": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["question", "why", "resolve"], "properties": { "question": { "type": "string" }, "why": { "type": "string" }, "resolve": { "type": "string" } } } } } } },
    "unknowns": { "type": "array", "items": { "type": "string" } },
    "constraints": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } }
  }
}
