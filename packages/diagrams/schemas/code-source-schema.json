{
  "$schema":"https://json-schema.org/draft/2020-12/schema", "$id":"https://atlas.local/code-source-v1",
  "type":"object", "required":["formatVersion","adapter","identity","projects"], "additionalProperties":false,
  "properties": {
    "formatVersion":{"const":1}, "adapter":{"enum":["typescript","java"]}, "identity":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"}, "title":{"type":"string","maxLength":300},
    "projects":{"type":"array","minItems":1,"maxItems":8,"items":{"type":"object","required":["identity","path"],"additionalProperties":false,"properties":{"identity":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},"path":{"type":"string","minLength":1},"tsconfig":{"type":"string","minLength":1},"files":{"type":"array","minItems":1,"maxItems":200,"uniqueItems":true,"items":{"type":"string","pattern":"\\.java$"}},"classpath":{"type":"array","maxItems":100,"items":{"type":"string","minLength":1}},"repositoryUrl":{"type":"string","pattern":"^https?://"}}}}
  },
  "allOf":[
    {"if":{"properties":{"adapter":{"const":"java"}}},"then":{"properties":{"projects":{"items":{"required":["files"],"not":{"required":["tsconfig"]}}}}}},
    {"if":{"properties":{"adapter":{"const":"typescript"}}},"then":{"properties":{"projects":{"items":{"not":{"anyOf":[{"required":["files"]},{"required":["classpath"]}]}}}}}}
  ]
}
